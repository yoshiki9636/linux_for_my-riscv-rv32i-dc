diff --git a/arch/riscv/kernel/traps.c b/arch/riscv/kernel/traps.c
index 5fb57fad1..86761e850 100644
--- a/arch/riscv/kernel/traps.c
+++ b/arch/riscv/kernel/traps.c
@@ -253,8 +253,20 @@ DO_ERROR_INFO(do_trap_store_fault,
 	SIGSEGV, SEGV_ACCERR, "store (or AMO) access fault");
 DO_ERROR_INFO(do_trap_ecall_s,
 	SIGILL, ILL_ILLTRP, "environment call from S-mode");
-DO_ERROR_INFO(do_trap_ecall_m,
-	SIGILL, ILL_ILLTRP, "environment call from M-mode");
+/*
+ * FPGA: the CPU has no U-mode, so userspace also runs in M-mode and every
+ * syscall arrives as mcause=11. entry.S clears the saved MPP for traps from
+ * userspace, so user_mode(regs) tells real syscalls apart.
+ */
+asmlinkage __visible __trap_section void do_trap_ecall_m(struct pt_regs *regs)
+{
+	if (user_mode(regs)) {
+		do_trap_ecall_u(regs);
+		return;
+	}
+	do_trap_error(regs, SIGILL, ILL_ILLTRP, regs->epc,
+		      "Oops - environment call from M-mode");
+}
 
